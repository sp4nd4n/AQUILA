<UserControl x:Class="HackerSimulator.GrubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}" Cursor="None"
             PreviewKeyDown="Grub_PreviewKeyDown"
             PreviewTextInput="Grub_PreviewTextInput">
    <Grid Background="Black">
        <!-- GRUB editor -->
        <Grid x:Name="EditorPage" Margin="56,40,56,36" IsHitTestVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="GNU GRUB  version 2.12" Foreground="#FFC8C8C8"
                       FontFamily="{StaticResource MonoFont}" FontSize="16"/>

            <Border Grid.Row="1" BorderBrush="#FFC8C8C8" BorderThickness="1" Margin="0,12,0,12"
                    Padding="12,8" ClipToBounds="True">
                <TextBlock x:Name="EditText" FontFamily="{StaticResource MonoFont}" FontSize="16"
                           Foreground="#FFC8C8C8" TextWrapping="NoWrap"/>
            </Border>

            <TextBlock Grid.Row="2" Foreground="#FFC8C8C8" FontFamily="{StaticResource MonoFont}" FontSize="15"
                       Margin="30,0,0,0" LineHeight="22">
                Minimum Emacs-like screen editing is supported. TAB lists<LineBreak/>
                completions. Press Ctrl-x or F10 to boot, Ctrl-c or F2 for a<LineBreak/>
                command-line or ESC to discard edits and return to the GRUB menu.
            </TextBlock>
        </Grid>

        <!-- boot log and recovery shell -->
        <ScrollViewer x:Name="ShellPage" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden"
                      Margin="28,22" IsHitTestVisible="False">
            <TextBlock x:Name="ShellText" FontFamily="{StaticResource MonoFont}" FontSize="15"
                       Foreground="#FFC8C8C8" TextWrapping="Wrap"/>
        </ScrollViewer>
    </Grid>
</UserControl>