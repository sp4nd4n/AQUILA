<UserControl x:Class="HackerSimulator.FileManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" Focusable="True" FocusVisualStyle="{x:Null}">
    <Grid Background="#FF161B22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <Border Grid.Row="0" Background="#FF1B2029" BorderBrush="{StaticResource DimBrush}"
                BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel>
                <Button Content="◀" DockPanel.Dock="Left" Style="{StaticResource NeonButton}" Padding="10,4"
                        Foreground="{StaticResource WhiteBrush}" Click="Back_Click"/>
                <Button Content="▲" DockPanel.Dock="Left" Style="{StaticResource NeonButton}" Padding="10,4"
                        Foreground="{StaticResource WhiteBrush}" Margin="6,0,0,0" Click="Up_Click"/>
                <Border Background="#FF0D1117" BorderBrush="{StaticResource DimBrush}" BorderThickness="1"
                        Margin="10,0,0,0" Padding="10,4">
                    <TextBlock x:Name="PathText" Foreground="{StaticResource WhiteBrush}"
                               FontFamily="{StaticResource MonoFont}" FontSize="13" VerticalAlignment="Center"/>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FF12161D" BorderBrush="{StaticResource DimBrush}"
                    BorderThickness="0,0,1,0">
                <StackPanel x:Name="Places" Margin="6,10"/>
            </Border>

            <Grid Grid.Column="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="Items" Margin="12"/>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource GrayBrush}" FontSize="16" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#FF1B2029" BorderBrush="{StaticResource DimBrush}"
                BorderThickness="0,1,0,0" Padding="10,4">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource GrayBrush}" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>