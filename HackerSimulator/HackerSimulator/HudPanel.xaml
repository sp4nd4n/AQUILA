<UserControl x:Class="HackerSimulator.HudPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource MonoFont}" Width="500">
    <Border Background="#F2161B22" BorderBrush="{StaticResource DimBrush}" BorderThickness="1">
        <StackPanel>
            <Border Background="#FF21262D" Padding="10,5">
                <TextBlock Text="htop  —  aquila" Foreground="{StaticResource GrayBrush}" FontSize="12"/>
            </Border>
            <TextBlock x:Name="CpuText" FontSize="12" LineHeight="17" Margin="10,8,10,8"
                       Foreground="{StaticResource WhiteBrush}"/>
            <Border Background="#FF21262D" Padding="10,5">
                <TextBlock x:Name="CapText" Foreground="{StaticResource GrayBrush}" FontSize="12"/>
            </Border>
            <TextBlock x:Name="PktText" FontSize="11" LineHeight="15" Margin="10,8,10,10"
                       Foreground="{StaticResource GrayBrush}" TextWrapping="NoWrap"/>
        </StackPanel>
    </Border>
</UserControl>