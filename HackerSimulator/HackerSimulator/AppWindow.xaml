<UserControl x:Class="HackerSimulator.AppWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Foreground" Value="{StaticResource GrayBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCloseBtn" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Foreground" Value="{StaticResource GrayBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- invisible resize handles: no white line/box, arrow cursors only -->
        <Style TargetType="Thumb">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="Frame" Background="{StaticResource BgBrush}" BorderBrush="#FF3A3F4B" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.6" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border x:Name="TitleBar" Grid.Row="0" Background="#FF1B1F27"
                        MouseLeftButtonDown="TitleBar_MouseDown"
                        MouseMove="TitleBar_MouseMove"
                        MouseLeftButtonUp="TitleBar_MouseUp">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="—" Style="{StaticResource WinBtn}" Click="Min_Click"/>
                            <Button Content="▢" Style="{StaticResource WinBtn}" Click="Max_Click"/>
                            <Button Content="✕" Style="{StaticResource WinCloseBtn}" Click="Close_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TitleText" Foreground="{StaticResource WhiteBrush}" FontSize="12"
                                   FontFamily="{StaticResource UiFont}" VerticalAlignment="Center"
                                   Margin="12,0" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>

                <ContentPresenter x:Name="Body" Grid.Row="1"/>
            </Grid>
        </Border>

        <!-- resize handles -->
        <Thumb Width="5" HorizontalAlignment="Left" Margin="0,10,0,10" Background="Transparent" Cursor="SizeWE" DragDelta="ResizeL"/>
        <Thumb Width="5" HorizontalAlignment="Right" Margin="0,10,0,10" Background="Transparent" Cursor="SizeWE" DragDelta="ResizeR"/>
        <Thumb Height="5" VerticalAlignment="Top" Margin="10,0,10,0" Background="Transparent" Cursor="SizeNS" DragDelta="ResizeT"/>
        <Thumb Height="5" VerticalAlignment="Bottom" Margin="10,0,10,0" Background="Transparent" Cursor="SizeNS" DragDelta="ResizeB"/>
        <Thumb Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNWSE" DragDelta="ResizeTL"/>
        <Thumb Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNESW" DragDelta="ResizeTR"/>
        <Thumb Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNESW" DragDelta="ResizeBL"/>
        <Thumb Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNWSE" DragDelta="ResizeBR"/>
    </Grid>
</UserControl>