<UserControl x:Class="HackerSimulator.BootSplashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#FF050608">
        <Grid x:Name="LogoHost" Width="360" Height="362" HorizontalAlignment="Center"
              VerticalAlignment="Center" Margin="0,-40,0,0">
            <Image x:Name="Base" Source="/Assets/aquila.png" Stretch="Uniform" Opacity="0"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <Rectangle x:Name="Chase" Opacity="0"/>
        </Grid>

        <TextBlock x:Name="ConsoleText" Visibility="Collapsed" Foreground="#FFD0D0D0"
                   FontFamily="{StaticResource MonoFont}" FontSize="15"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,10,0,0"/>
    </Grid>
</UserControl>