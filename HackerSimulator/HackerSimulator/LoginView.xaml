<UserControl x:Class="HackerSimulator.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HackerSimulator"
             Focusable="True" FocusVisualStyle="{x:Null}"
             PreviewKeyDown="Login_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="LoginText" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#FF2E3440"/>
            <Setter Property="CaretBrush" Value="#FF2E3440"/>
            <Setter Property="Padding" Value="0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="#FFF3F8FE" BorderBrush="#FFD4DEE8" BorderThickness="1" CornerRadius="2">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF0C69FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginPass" TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#FF2E3440"/>
            <Setter Property="CaretBrush" Value="#FF2E3440"/>
            <Setter Property="PasswordChar" Value="●"/>
            <Setter Property="Padding" Value="0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="#FFF3F8FE" BorderBrush="#FFD4DEE8" BorderThickness="1" CornerRadius="2">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF0C69FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlueBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF0C69FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2B7DFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GrayBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#FF333333"/>
            <Setter Property="Background" Value="#FFEBEBEB"/>
            <Setter Property="BorderBrush" Value="#FFD6D6D6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PowerStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16" Padding="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#FF0B2E8F">
        <!-- everything inside is laid out on the reference screenshot's own 1510 x 902 canvas -->
        <Viewbox Stretch="UniformToFill">
            <Canvas Width="1510" Height="902">
                <Image Source="/Assets/login_bg.jpg" Width="1510" Height="902"/>

                <!-- login box (a little larger than the one in the screenshot, so nothing shows through) -->
                <Border Canvas.Left="544" Canvas.Top="333" Width="422" Height="231" CornerRadius="4"
                        Background="#FFF5F9FF">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.45" Color="#FF001445"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="144"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#FFE1EDFC" CornerRadius="4,4,0,0"/>
                        <Border Grid.Row="1" Background="#FFF5F9FF" CornerRadius="0,0,4,4"
                                BorderBrush="#FFDDE9F8" BorderThickness="0,1,0,0"/>

                        <Canvas Grid.RowSpan="2">
                            <!-- avatar -->
                            <Ellipse Canvas.Left="41" Canvas.Top="47" Width="76" Height="76" Fill="#FF0A3A7D"/>
                            <local:EagleLogo Canvas.Left="54" Canvas.Top="59" Width="50" Height="50"/>

                            <!-- username -->
                            <TextBox x:Name="UserBox" Canvas.Left="144" Canvas.Top="44" Width="246" Height="37"
                                     Style="{StaticResource LoginText}"/>
                            <TextBlock x:Name="UserHint" Canvas.Left="147" Canvas.Top="53" Text="Enter your username"
                                       FontFamily="Segoe UI" FontSize="14" Foreground="#FF8E99A8" IsHitTestVisible="False"/>

                            <!-- password -->
                            <PasswordBox x:Name="PassBox" Canvas.Left="144" Canvas.Top="94" Width="246" Height="37"
                                         Style="{StaticResource LoginPass}"/>
                            <TextBlock x:Name="PassHint" Canvas.Left="147" Canvas.Top="103" Text="Enter your password"
                                       FontFamily="Segoe UI" FontSize="14" Foreground="#FF8E99A8" IsHitTestVisible="False"/>

                            <!-- buttons -->
                            <Button Canvas.Left="31" Canvas.Top="165" Width="97" Height="33" Content="Cancel"
                                    Style="{StaticResource GrayBtn}" Click="Cancel_Click"/>
                            <Button Canvas.Left="299" Canvas.Top="165" Width="91" Height="33" Content="Log In"
                                    Style="{StaticResource BlueBtn}" Click="LogIn_Click"/>
                        </Canvas>
                    </Grid>
                </Border>

                <TextBlock x:Name="Message" Canvas.Left="544" Canvas.Top="576" Width="422" TextAlignment="Center"
                           FontFamily="Segoe UI" FontSize="15" Foreground="White">
                    <TextBlock.Effect>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.8" Color="#FF001445"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Canvas>
        </Viewbox>

        <!-- power button -->
        <Button x:Name="PowerBtn" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,14,0"
                Style="{StaticResource PowerStyle}" Click="PowerBtn_Click">
            <Image Source="/Assets/power.png" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Button>
        <Popup x:Name="PowerPopup" PlacementTarget="{Binding ElementName=PowerBtn}" Placement="Bottom"
               HorizontalOffset="-110" StaysOpen="False" AllowsTransparency="True">
            <Border Background="#F2FFFFFF" BorderBrush="#FFC9D3E3" BorderThickness="1" CornerRadius="3"
                    Padding="8" Margin="0,2,0,12">
                <StackPanel Width="140">
                    <Button Content="Restart" Height="32" Style="{StaticResource GrayBtn}" Click="Restart_Click"/>
                    <Button Content="Shut Down" Height="32" Margin="0,6,0,0" Style="{StaticResource BlueBtn}"
                            Click="ShutDown_Click"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>