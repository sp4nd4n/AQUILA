<UserControl x:Class="HackerSimulator.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HackerSimulator"
             FontFamily="{StaticResource MonoFont}"
             PreviewKeyDown="Console_PreviewKeyDown"
             PreviewTextInput="Console_PreviewTextInput">
    <Grid Background="{StaticResource BgBrush}">
        <Grid Margin="14,10,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- terminal (selectable text) -->
            <RichTextBox x:Name="Terminal" Grid.Column="0"
                         IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0"
                         FontSize="16" Foreground="{StaticResource WhiteBrush}"
                         VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                         IsInactiveSelectionHighlightEnabled="True"
                         SelectionBrush="{StaticResource CyanBrush}" SelectionOpacity="0.35"
                         FocusVisualStyle="{x:Null}">
                <FlowDocument PagePadding="0" Background="Transparent">
                    <Paragraph x:Name="TermPara" Margin="0"/>
                </FlowDocument>
            </RichTextBox>

            <!-- system monitor (shown while a command is attacking) -->
            <local:HudPanel x:Name="Hud" Grid.Column="1" Margin="18,0,0,0"
                            VerticalAlignment="Top" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>