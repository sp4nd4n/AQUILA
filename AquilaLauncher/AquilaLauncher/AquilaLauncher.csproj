<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>aquila.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\aquila.ico" />
    <None Remove="Assets\aquila.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="aquila.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\aquila.ico" />
    <Resource Include="Assets\aquila.png" />
  </ItemGroup>

</Project>
