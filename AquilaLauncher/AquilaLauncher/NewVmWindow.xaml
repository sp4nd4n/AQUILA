<Window x:Class="AquilaLauncher.NewVmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New virtual machine" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}" Icon="/Assets/aquila.ico">
    <Border Padding="30,26">
        <StackPanel>
            <TextBlock Text="Create a virtual machine" FontSize="22" FontWeight="SemiBold"/>

            <TextBlock Text="Virtual machine name" Style="{StaticResource FieldLabel}" Margin="0,20,0,5"/>
            <TextBox x:Name="NameBox"/>

            <TextBlock Text="AQUILA image (.iso)" Style="{StaticResource FieldLabel}"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource GhostButton}"
                        Padding="16,8" Margin="8,0,0,0" Click="Browse_Click"/>
                <TextBox x:Name="IsoBox" IsReadOnly="True"/>
            </DockPanel>

            <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="0,24,0,2"/>
            <TextBlock Text="Your account" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0"/>

            <TextBlock Text="Full name" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="FullBox"/>

            <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="UserBox"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="PassBox"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Confirm password" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="ConfirmBox"/>
                </StackPanel>
            </Grid>

            <ProgressBar x:Name="Bar" Height="6" Margin="0,22,0,0" Visibility="Collapsed"
                         Foreground="{StaticResource AccentBrush}" Background="{StaticResource LineBrush}"
                         BorderThickness="0"/>
            <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap" MinHeight="20"
                       Foreground="{StaticResource MutedBrush}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="CancelBtn" Content="Cancel" Style="{StaticResource GhostButton}" Click="Cancel_Click"/>
                <Button x:Name="CreateBtn" Content="Create" Style="{StaticResource AccentButton}"
                        Margin="10,0,0,0" MinWidth="120" Click="Create_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>