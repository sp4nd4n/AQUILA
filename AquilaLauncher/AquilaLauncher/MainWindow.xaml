<Window x:Class="AquilaLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AQUILA LAUNCHER" Width="1000" Height="640" MinWidth="880" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}"
        Icon="/Assets/aquila.ico">
    <Window.Resources>
        <Style x:Key="VmItem" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="12,10" Margin="0,0,0,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF152647"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1B3566"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- sidebar -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Image Source="/Assets/aquila.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="AQUILA LAUNCHER" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </StackPanel>

                <Button Grid.Row="1" Content="＋  New virtual machine" Style="{StaticResource AccentButton}"
                        Margin="0,22,0,16" Click="New_Click"/>

                <ListBox x:Name="VmList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource VmItem}" SelectionChanged="VmList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- empty state -->
        <StackPanel x:Name="EmptyPanel" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="/Assets/aquila.png" Width="150" Height="150" Opacity="0.25"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="No virtual machines yet" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Margin="0,18,0,6"/>
            <TextBlock Text="Click “New virtual machine” to create one from an AQUILA .iso file."
                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- details -->
        <Grid x:Name="DetailPanel" Grid.Column="1" Margin="44,40" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Image Source="/Assets/aquila.png" Width="84" Height="84" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" FontSize="14" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="24,18" Margin="0,30,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Account" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="UserText" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="1" Text="System image" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="IsoText" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="2" Text="Created" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CreatedText"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,26,0,0">
                <Button x:Name="StartBtn" Content="▶  Start" Style="{StaticResource AccentButton}"
                        MinWidth="140" Click="Start_Click"/>
                <Button x:Name="DeleteBtn" Content="Delete" Style="{StaticResource GhostButton}"
                        Foreground="{StaticResource DangerBrush}" Margin="12,0,0,0" Click="Delete_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>